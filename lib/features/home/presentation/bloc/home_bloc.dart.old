// lib/features/home/presentation/bloc/home_bloc.dart
// BLoC for home page state management

import 'package:flutter_bloc/flutter_bloc.dart';
import 'package:balaji_points/features/home/data/repositories/home_repository.dart';
import 'package:balaji_points/features/home/presentation/bloc/home_event.dart';
import 'package:balaji_points/features/home/presentation/bloc/home_state.dart';
import 'package:balaji_points/core/utils/app_logger.dart';

class HomeBloc extends Bloc<HomeEvent, HomeState> {
  final HomeRepository repository;

  HomeBloc({required this.repository}) : super(const HomeState()) {
    on<LoadHomeData>(_onLoadHomeData);
    on<RefreshHomeData>(_onRefreshHomeData);
    on<LoadOffers>(_onLoadOffers);
    on<LoadLeaderboard>(_onLoadLeaderboard);
    on<LoadUserData>(_onLoadUserData);
    on<UpdateUserPoints>(_onUpdateUserPoints);
  }

  /// Load all home data (initial load)
  Future<void> _onLoadHomeData(
    LoadHomeData event,
    Emitter<HomeState> emit,
  ) async {
    AppLogger.blocEvent('HomeBloc', 'LoadHomeData');
    emit(state.copyWith(status: HomeStatus.loading));

    try {
      // Load user data first (most important)
      final userData = await repository.loadUserData();

      emit(state.copyWith(
        userData: userData,
        status: HomeStatus.success,
      ));

      // Load other data in parallel
      final results = await Future.wait([
        repository.loadOffers(),
        repository.loadTopCarpenters(),
        repository.getCurrentUserRank(),
        repository.getTodaysWinner(),
      ]);

      emit(state.copyWith(
        offers: results[0] as List,
        topCarpenters: results[1] as List,
        currentUserRank: results[2],
        todaysWinner: results[3],
        status: HomeStatus.success,
      ));

      AppLogger.blocState('HomeBloc', 'LoadHomeData success');
    } catch (e, stackTrace) {
      AppLogger.error('HomeBloc LoadHomeData failed',
          error: e, stackTrace: stackTrace);
      emit(state.copyWith(
        status: HomeStatus.error,
        errorMessage: e.toString(),
      ));
    }
  }

  /// Refresh all data (pull-to-refresh)
  Future<void> _onRefreshHomeData(
    RefreshHomeData event,
    Emitter<HomeState> emit,
  ) async {
    AppLogger.blocEvent('HomeBloc', 'RefreshHomeData');

    try {
      // Refresh all data
      final results = await Future.wait([
        repository.loadUserData(),
        repository.loadOffers(),
        repository.loadTopCarpenters(),
        repository.getCurrentUserRank(),
        repository.getTodaysWinner(),
      ]);

      emit(state.copyWith(
        userData: results[0] as Map<String, dynamic>?,
        offers: results[1] as List,
        topCarpenters: results[2] as List,
        currentUserRank: results[3],
        todaysWinner: results[4],
        status: HomeStatus.success,
      ));

      AppLogger.blocState('HomeBloc', 'RefreshHomeData success');
    } catch (e, stackTrace) {
      AppLogger.error('HomeBloc RefreshHomeData failed',
          error: e, stackTrace: stackTrace);
      // Don't show error on refresh, keep existing data
    }
  }

  /// Load only offers
  Future<void> _onLoadOffers(
    LoadOffers event,
    Emitter<HomeState> emit,
  ) async {
    AppLogger.blocEvent('HomeBloc', 'LoadOffers');
    emit(state.copyWith(offersLoading: true));

    try {
      final offers = await repository.loadOffers();
      emit(state.copyWith(
        offers: offers,
        offersLoading: false,
      ));
      AppLogger.blocState('HomeBloc', 'LoadOffers success');
    } catch (e, stackTrace) {
      AppLogger.error('HomeBloc LoadOffers failed',
          error: e, stackTrace: stackTrace);
      emit(state.copyWith(offersLoading: false));
    }
  }

  /// Load only leaderboard
  Future<void> _onLoadLeaderboard(
    LoadLeaderboard event,
    Emitter<HomeState> emit,
  ) async {
    AppLogger.blocEvent('HomeBloc', 'LoadLeaderboard');
    emit(state.copyWith(leaderboardLoading: true));

    try {
      final results = await Future.wait([
        repository.loadTopCarpenters(),
        repository.getCurrentUserRank(),
        repository.getTodaysWinner(),
      ]);

      emit(state.copyWith(
        topCarpenters: results[0] as List,
        currentUserRank: results[1],
        todaysWinner: results[2],
        leaderboardLoading: false,
      ));

      AppLogger.blocState('HomeBloc', 'LoadLeaderboard success');
    } catch (e, stackTrace) {
      AppLogger.error('HomeBloc LoadLeaderboard failed',
          error: e, stackTrace: stackTrace);
      emit(state.copyWith(leaderboardLoading: false));
    }
  }

  /// Load user data
  Future<void> _onLoadUserData(
    LoadUserData event,
    Emitter<HomeState> emit,
  ) async {
    AppLogger.blocEvent('HomeBloc', 'LoadUserData');
    emit(state.copyWith(userDataLoading: true));

    try {
      final userData = await repository.loadUserData();
      emit(state.copyWith(
        userData: userData,
        userDataLoading: false,
      ));
      AppLogger.blocState('HomeBloc', 'LoadUserData success');
    } catch (e, stackTrace) {
      AppLogger.error('HomeBloc LoadUserData failed',
          error: e, stackTrace: stackTrace);
      emit(state.copyWith(userDataLoading: false));
    }
  }

  /// Update user points
  Future<void> _onUpdateUserPoints(
    UpdateUserPoints event,
    Emitter<HomeState> emit,
  ) async {
    AppLogger.blocEvent('HomeBloc', 'UpdateUserPoints',
        data: {'points': event.newPoints});

    if (state.userData != null) {
      final updatedUserData = Map<String, dynamic>.from(state.userData!);
      updatedUserData['points'] = event.newPoints;
      emit(state.copyWith(userData: updatedUserData));
    }
  }
}

