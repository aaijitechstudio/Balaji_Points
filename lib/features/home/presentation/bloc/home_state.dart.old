// lib/features/home/presentation/bloc/home_state.dart
// States for home page BLoC

import 'package:equatable/equatable.dart';
import 'package:balaji_points/features/home/data/models/offer_model.dart';
import 'package:balaji_points/features/home/data/models/carpenter_rank_model.dart';

enum HomeStatus {
  initial,
  loading,
  success,
  error,
}

class HomeState extends Equatable {
  final HomeStatus status;
  final List<OfferModel> offers;
  final bool offersLoading;
  final List<CarpenterRankModel> topCarpenters;
  final bool leaderboardLoading;
  final CarpenterRankModel? currentUserRank;
  final CarpenterRankModel? todaysWinner;
  final Map<String, dynamic>? userData;
  final bool userDataLoading;
  final String? errorMessage;

  const HomeState({
    this.status = HomeStatus.initial,
    this.offers = const [],
    this.offersLoading = false,
    this.topCarpenters = const [],
    this.leaderboardLoading = false,
    this.currentUserRank,
    this.todaysWinner,
    this.userData,
    this.userDataLoading = false,
    this.errorMessage,
  });

  // Convenience getters
  bool get isLoading => status == HomeStatus.loading;
  bool get isSuccess => status == HomeStatus.success;
  bool get isError => status == HomeStatus.error;
  bool get hasOffers => offers.isNotEmpty;
  bool get hasLeaderboard => topCarpenters.isNotEmpty;
  bool get hasUserData => userData != null;

  // User data getters
  String get userName {
    if (userData == null) return 'Guest';
    final firstName = userData!['firstName'] as String? ?? '';
    final lastName = userData!['lastName'] as String? ?? '';
    final name = '$firstName $lastName'.trim();
    return name.isNotEmpty ? name : 'User';
  }

  int get userPoints => userData?['points'] as int? ?? 0;

  String get userTier => userData?['tier'] as String? ?? 'Bronze';

  String? get userImageUrl => userData?['imageUrl'] as String?;

  bool get isCarpenter => userData?['role'] == 'carpenter';

  String? get userId => userData?['uid'] as String?;

  // Profile completion check
  bool get isProfileComplete {
    if (userData == null) return false;
    final firstName = userData!['firstName'] as String?;
    final lastName = userData!['lastName'] as String?;
    final phone = userData!['phone'] as String?;
    return firstName != null &&
        firstName.isNotEmpty &&
        lastName != null &&
        lastName.isNotEmpty &&
        phone != null &&
        phone.isNotEmpty;
  }

  HomeState copyWith({
    HomeStatus? status,
    List<OfferModel>? offers,
    bool? offersLoading,
    List<CarpenterRankModel>? topCarpenters,
    bool? leaderboardLoading,
    CarpenterRankModel? currentUserRank,
    CarpenterRankModel? todaysWinner,
    Map<String, dynamic>? userData,
    bool? userDataLoading,
    String? errorMessage,
  }) {
    return HomeState(
      status: status ?? this.status,
      offers: offers ?? this.offers,
      offersLoading: offersLoading ?? this.offersLoading,
      topCarpenters: topCarpenters ?? this.topCarpenters,
      leaderboardLoading: leaderboardLoading ?? this.leaderboardLoading,
      currentUserRank: currentUserRank ?? this.currentUserRank,
      todaysWinner: todaysWinner ?? this.todaysWinner,
      userData: userData ?? this.userData,
      userDataLoading: userDataLoading ?? this.userDataLoading,
      errorMessage: errorMessage,
    );
  }

  @override
  List<Object?> get props => [
        status,
        offers,
        offersLoading,
        topCarpenters,
        leaderboardLoading,
        currentUserRank,
        todaysWinner,
        userData,
        userDataLoading,
        errorMessage,
      ];
}

