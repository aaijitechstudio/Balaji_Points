// lib/features/home/presentation/bloc/home_event.dart
// Events for home page BLoC

import 'package:equatable/equatable.dart';

abstract class HomeEvent extends Equatable {
  const HomeEvent();

  @override
  List<Object?> get props => [];
}

/// Load initial data (user, offers, leaderboard)
class LoadHomeData extends HomeEvent {
  const LoadHomeData();
}

/// Refresh all home data (pull-to-refresh)
class RefreshHomeData extends HomeEvent {
  const RefreshHomeData();
}

/// Load only offers
class LoadOffers extends HomeEvent {
  const LoadOffers();
}

/// Load only leaderboard
class LoadLeaderboard extends HomeEvent {
  const LoadLeaderboard();
}

/// Load user data
class LoadUserData extends HomeEvent {
  const LoadUserData();
}

/// Update user points (when points change)
class UpdateUserPoints extends HomeEvent {
  final int newPoints;

  const UpdateUserPoints(this.newPoints);

  @override
  List<Object?> get props => [newPoints];
}

